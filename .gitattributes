# توحيد نهايات الأسطر عبر Windows/Linux — النصوص والكود بـ LF، وسكربتات Windows بـ CRLF
* text=auto eol=lf

# كود ومصادر برمجية: LF دائماً
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.svg text eol=lf
*.md text eol=lf

# ملفات Windows النصية: CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# ملفات ثنائية: لا تُلمس نهايات أسطرها
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary
*.woff binary
*.woff2 binary
