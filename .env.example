# ════════════════════════════════════════════════════════════════
# .env.example — أسماء متغيرات البيئة المطلوبة
# انسخ هذا الملف إلى .env وأضف القيم الحقيقية **محليًا**
# لا ترفع ملف .env إلى Git — محمي في .gitignore
# ════════════════════════════════════════════════════════════════

# ─── قاعدة البيانات المحلية (Docker Compose) ─────────────────
POSTGRES_USER=qemma_dev
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DB=qemma_erp_dev
POSTGRES_PORT=5432

# ─── FastAPI ─────────────────────────────────────────────────
# متغير DATABASE_URL مطلوب صراحة لتشغيل الخادم (لا توجد كلمة مرور افتراضية مدمجة في الكود)
# القيمة أدناه مخصصة للتطوير المحلي مع Docker Compose فقط:
DATABASE_URL=postgresql+asyncpg://qemma_dev:changeme_local_only@localhost:5432/qemma_erp_dev
APP_ENV=development
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ─── Supabase (فارغة في التطوير المحلي) ─────────────────────
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/jwks

# ─── الواجهة React/Vite (قيم عامة فقط) ─────────────────────
VITE_API_BASE_URL=http://localhost:8000
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon-key-public>

# ────────────────────────────────────────────────────────────────
# تحذير: لا تضع SUPABASE_JWT_SECRET أو DATABASE_URL الحقيقي
# في VITE_* — متغيرات Vite المسبوقة VITE_ تذهب للمتصفح.
# ════════════════════════════════════════════════════════════════
