# ════════════════════════════════════════════════════════════════
# .env.example — أسماء متغيرات البيئة المطلوبة
# انسخ هذا الملف إلى .env وأضف القيم الحقيقية **محليًا**
# لا ترفع ملف .env إلى Git — محمي في .gitignore
# ════════════════════════════════════════════════════════════════

# ─── قاعدة البيانات المحلية (Docker Compose) ─────────────────
POSTGRES_USER=qemma_dev
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DB=qemma_erp_dev
POSTGRES_PORT=5432

# ─── FastAPI ─────────────────────────────────────────────────
# متغير DATABASE_URL مطلوب صراحة لتشغيل الخادم (لا توجد كلمة مرور افتراضية مدمجة في الكود)
# القيمة أدناه مخصصة للتطوير المحلي مع Docker Compose فقط:
DATABASE_URL=postgresql+asyncpg://qemma_dev:changeme_local_only@localhost:5432/qemma_erp_dev
APP_ENV=development
LOG_LEVEL=debug
# النطاقات المصرح لها بالاتصال (CORS_ALLOWED_ORIGINS) — قائمة مفصولة بفاصلة أو مصفوفة JSON:
# للتطوير المحلي: النطاقات الافتراضية صريحة (http://localhost:5173,http://127.0.0.1:5173)
# في بيئة الإنتاج: يجب تحديد نطاقات النطاق الموثوق فقط (مثال: https://app.example.com)
# تحذير أمني: يمنع استخدام النطاق العام '*' أو 'null' نهائياً عند تفعيل الاعتمادات والمصادقة.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── المصادقة المحلية للتطوير (Local Development Authentication) ───
# لتشغيل النظام محلياً بشكل مستقل تماماً بدون Supabase:
# DEV_AUTH_ENABLED=true
# LOCAL_JWT_SECRET=super-secret-development-key-that-is-at-least-32-chars-long!
# تنبيه أمني: يُحظر DEV_AUTH_ENABLED في الإنتاج؛ سيفشل إقلاع السيرفر إذا كان APP_ENV=production.

# ─── Supabase Auth / JWT (التحقق الخادمي من التوقيع غير المتماثل عبر JWKS) ───
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
# SUPABASE_JWT_AUDIENCE=authenticated

# ─── الواجهة React/Vite (قيم عامة فقط) ─────────────────────
VITE_API_BASE_URL=http://localhost:8000
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon-key-public>

# ────────────────────────────────────────────────────────────────
# تحذير: لا تضع SUPABASE_JWT_SECRET أو DATABASE_URL الحقيقي
# في VITE_* — متغيرات Vite المسبوقة VITE_ تذهب للمتصفح.
# ════════════════════════════════════════════════════════════════
