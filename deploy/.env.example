# انسخ هذا الملف إلى deploy/.env على السيرفر واملأ القيم. لا ترفع .env إلى GitHub.

# نطاق الـ API الذي يشير إلى IP السيرفر (سجل A في DNS)
API_DOMAIN=api.example.com

# رابط قاعدة Supabase عبر Session Pooler (IPv4) — من Supabase: Project Settings > Database > Connection string > Session pooler
# الصيغة: postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# مشروع Supabase (للتحقق من توكنات الدخول)
SUPABASE_URL=https://<project-ref>.supabase.co

# عنوان الواجهة على Cloudflare Pages (أو النطاق الخاص بها). أكثر من عنوان بفاصلة.
CORS_ALLOWED_ORIGINS=https://qema-erp.pages.dev
